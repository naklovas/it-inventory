{
  /* ---------------------------------------------------------------------
     Tum SQL Server baglanti dizeleri burada toplanir.
     BookRunner    : uygulamanin kendi veritabani
     ServiceManager: SCSM Data Warehouse (salt-okunur; bos ise entegrasyon kapali)
     --------------------------------------------------------------------- */
  "ConnectionStrings": {
    "BookRunner": "Server=SQLSRV01;Database=BookRunner;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "ServiceManager": "Server=SCSMDW01;Database=DWDataMart;Integrated Security=true;TrustServerCertificate=true;ApplicationIntent=ReadOnly"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  /* Frontend ile API ayni sunucuda calisiyor; buraya Web'in adresleri yazilir. */
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080", "https://localhost:7080" ]
  },

  /* ---------------------------------------------------------------------
     Active Directory. Tek domainli kurulumda yalnizca "Domain" yeterlidir.
     Birden fazla etki alani varsa "Domains" listesini doldurun; arama tum
     etki alanlarinda calisir, SID cozumlemesi ilk eslesmede durur.
     --------------------------------------------------------------------- */
  "ActiveDirectory": {
    "Domain": "fintek.local",
    "SearchRoot": "",
    "ServiceAccountUserName": "",
    "ServiceAccountPassword": "",

    "Domains": [],

    "CacheMinutes": 30,
    "MaxSearchResults": 50,
    "PhotoAttributes": [ "thumbnailPhoto", "jpegPhoto" ],
    "Disabled": false
  },

  /* ---------------------------------------------------------------------
     Kurum ici personel bilgi servisi. Kullanicinin takim adi ve fotografi
     AD grup uyeliginden degil buradan alinir: GET {BaseUrl}{LookupPathTemplate}
     (kullanici adi {0} yerine konur), orn.
       GET http://doku:5406/api/personel/visikhan
     Beklenen yanit: { "username": "...", "teamName": "...", "thumbnail": "<base64 jpeg>" }

     TeamsPath: sirketteki tum ekipleri tek seferde listeler, orn.
       GET http://doku:5406/api/takimlar
     Beklenen yanit: [{ "ekipAdi": "...", "yoneticiler": [...], "kadrolu": [...], "danisman": [...] }, ...]
     Yalnizca "ekipAdi" kullanilir (uye listeleri kullanici adi degil ad-soyad
     icerdiginden BookRunner hesabiyla guvenilir eslestirilemez); bu uc,
     TeamCatalogSyncMinutes'ta belirtilen sure ile arka planda periyodik
     olarak cekilip atama arama kutusundaki "Takim" listesini besler - boylece
     henuz kimsesi giris yapmamis bir ekip de bastan aranabilir olur.
     --------------------------------------------------------------------- */
  "PersonnelDirectory": {
    "Enabled": true,
    "BaseUrl": "http://doku:5406",
    "LookupPathTemplate": "/api/personel/{0}",
    "TeamsPath": "/api/takimlar",
    "TeamCatalogSyncMinutes": 60,
    "TimeoutSeconds": 5
  },

  /* ---------------------------------------------------------------------
     Rol turetme.

     ONEMLI: Bu bolum yalnizca "kim uygulamada ne yapabilir" sorusunu
     yanitlar. Bir runbook'un SAHIBI ile ilgisi yoktur; sahip, runbook'u
     kim olusturduysa odur (Runbooks.OwnerUserId) ve sahibi kendi
     runbook'unda her degisikligi yapabilir. Sahibin hangi takimda oldugu
     onemli degildir.

     DefaultRole: hicbir esleme tutmayan kullanicinin rolu.
       "Viewer"        -> kapali kurulum: yalnizca asagida eslenen
                          takimlardaki kisiler runbook acabilir.
       "Contributor"   -> acik kurulum (ONERILEN): etki alanindaki herkes
                          kendi runbook'unu acabilir, actiginin sahibi olur,
                          o runbook'ta gorev ekleyebilir/atayabilir/editor
                          belirleyebilir - ama BASKASININ runbook'unu
                          duzenleyemez (sadece kendi runbook'u). TeamRoleMappings
                          bu durumda yalnizca yonetici/yazar belirlemek icin
                          kullanilir.
       "RunbookAuthor" -> daha genis acik kurulum: yukaridakine ek olarak
                          BASKALARININ runbook'unu da duzenleyebilir/atama
                          yapabilir (RunbookWrite). Tek bir ekip/departman
                          gibi herkesin birbirinin runbook'una mudahale
                          edebilmesi gereken kurulumlar icin.

     DIKKAT: Viewer yalnizca okuyabilir; yorum yazamaz, gorev durumu
     degistiremez, gorev devredemez, runbook acamaz. Bu nedenle GOREV
     ATADIGINIZ takimlari en az "Contributor" olarak eslemeniz gerekir.
     Aksi halde goreve atanan kisi gorevi gorur ama uzerinde islem yapamaz.

     TeamRoleMappings: asagidaki takim adlari yalnizca ORNEKTIR. TeamName,
     PersonnelDirectory servisinin dondurdugu "teamName" degeriyle BIREBIR
     (harf buyuk/kucuklugu onemsiz) eslesmelidir. Bir kullanicinin takimi
     birden fazla satirla eslesmisse en yuksek rol gecerlidir.
     Roller: Viewer, Contributor, RunbookAuthor, Administrator
     --------------------------------------------------------------------- */
  "Authorization": {
    "DefaultRole": "Contributor",

    "TeamRoleMappings": [
      {
        "TeamName": "Konfigürasyon ve Değişiklik Yönetimi",
        "Role": "Administrator"
      },
      {
        "TeamName": "Sunucu Ekibi",
        "Role": "RunbookAuthor"
      },
      {
        "TeamName": "Servis Masası",
        "Role": "Contributor"
      }
    ]
  },

  "Email": {
    "Enabled": true,
    "Host": "smtp.contoso.com",
    "Port": 25,
    "UseStartTls": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "bookrunner@contoso.com",
    "FromDisplayName": "BookRunner",
    "WebBaseUrl": "http://localhost:5080",
    "MaxAttempts": 5,
    "PollingSeconds": 30,
    "BatchSize": 20,
    "RedirectAllTo": ""
  },

  /* Service Manager entegrasyonu (varsayilan: kapali).

     Baglanti dizesi yukaridaki ConnectionStrings:ServiceManager degerinden
     gelir. Varsayilan SearchQuery/GetByIdQuery degerleri Microsoft SCSM'in
     Data Warehouse semasina gore yazilmis ORNEKLERDIR. Baska bir Service
     Manager urunu (orn. OpenText SM) kullaniyorsaniz bu iki sorguyu kendi
     tablolarinizla degistirin; kod degistirmek gerekmez. Sorgunun donmesi
     gereken sutunlar:
       Id, Title, Description, Status, Category, AssignedTo,
       CreatedBy, CreatedDate, ScheduledStartDate, ScheduledEndDate, WorkItemType
     Parametreler: arama icin @term ve @take, tekil kayit icin @id */
  "ServiceManager": {
    "Enabled": false,
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },

  "Scripting": {
    "Enabled": true,
    "DefaultTimeoutSeconds": 60,
    "MaxOutputLines": 500
  },

  /* Oyunlastirma puan degerleri. Bir deger sonradan degistirilse bile daha once
     verilmis puanlar (GamificationEvents tablosu) etkilenmez; yalnizca bundan
     sonraki olaylar yeni degerle hesaplanir. */
  "Gamification": {
    "Enabled": true,
    "TaskCompletionPoints": 10,
    "HighPriorityMultiplier": 1.5,
    "CriticalPriorityMultiplier": 2.0,
    "OnTimeBonusPoints": 5,
    "TaskFailedPenaltyPoints": -5,
    "RunbookCompletionPoints": 50,
    "CommentPoints": 1
  },

  "Integration": {
    "Enabled": false,
    "BaseUrl": "",
    "EventPath": "/api/events",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "EventTypes": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "BookRunner": "Information"
    }
  },

  "AllowedHosts": "*"
}
