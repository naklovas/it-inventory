{
  "ConnectionStrings": {
    "BookRunner": "Server=localhost;Database=BookRunner;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080", "https://localhost:7080" ]
  },

  "ActiveDirectory": {
    "Domain": "",
    "SearchRoot": "",
    "ServiceAccountUserName": "",
    "ServiceAccountPassword": "",
    "CacheMinutes": 30,
    "MaxSearchResults": 50,
    "PhotoAttributes": [ "thumbnailPhoto", "jpegPhoto" ],
    "Disabled": false
  },

  "Authorization": {
    "RoleMappings": [
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1001",
        "GroupName": "BookRunner-Administrators",
        "Role": "Administrator"
      },
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1002",
        "GroupName": "BookRunner-Authors",
        "Role": "RunbookAuthor"
      },
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1003",
        "GroupName": "BookRunner-Contributors",
        "Role": "Contributor"
      }
    ]
  },

  "Email": {
    "Enabled": true,
    "Host": "smtp.contoso.com",
    "Port": 25,
    "UseStartTls": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "bookrunner@contoso.com",
    "FromDisplayName": "BookRunner",
    "WebBaseUrl": "http://localhost:5080",
    "MaxAttempts": 5,
    "PollingSeconds": 30,
    "BatchSize": 20,
    "RedirectAllTo": ""
  },

  "ServiceManager": {
    "Enabled": false,
    "ConnectionString": "Server=scsm-dw;Database=DWDataMart;Integrated Security=true;TrustServerCertificate=true",
    "CommandTimeoutSeconds": 30
  },

  "Scripting": {
    "Enabled": true,
    "DefaultTimeoutSeconds": 60,
    "MaxOutputLines": 500
  },

  "Integration": {
    "Enabled": false,
    "BaseUrl": "",
    "EventPath": "/api/events",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "EventTypes": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "BookRunner": "Information"
    }
  },

  "AllowedHosts": "*"
}
