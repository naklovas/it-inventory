{
  /* ---------------------------------------------------------------------
     Tum SQL Server baglanti dizeleri burada toplanir.
     BookRunner    : uygulamanin kendi veritabani
     ServiceManager: SCSM Data Warehouse (salt-okunur; bos ise entegrasyon kapali)
     --------------------------------------------------------------------- */
  "ConnectionStrings": {
    "BookRunner": "Server=SQLSRV01;Database=BookRunner;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "ServiceManager": "Server=SCSMDW01;Database=DWDataMart;Integrated Security=true;TrustServerCertificate=true;ApplicationIntent=ReadOnly"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  /* Frontend ile API ayni sunucuda calisiyor; buraya Web'in adresleri yazilir. */
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080", "https://localhost:7080" ]
  },

  /* ---------------------------------------------------------------------
     Active Directory. Tek domainli kurulumda yalnizca "Domain" yeterlidir.
     Birden fazla etki alani varsa "Domains" listesini doldurun; arama tum
     etki alanlarinda calisir, SID cozumlemesi ilk eslesmede durur.
     --------------------------------------------------------------------- */
  "ActiveDirectory": {
    "Domain": "contoso.com",
    "SearchRoot": "",
    "ServiceAccountUserName": "",
    "ServiceAccountPassword": "",

    "Domains": [
      {
        "Name": "contoso.com",
        "NetBiosName": "CONTOSO",
        "SearchRoot": "DC=contoso,DC=com",
        "ServiceAccountUserName": "",
        "ServiceAccountPassword": ""
      }
    ],

    "CacheMinutes": 30,
    "MaxSearchResults": 50,
    "PhotoAttributes": [ "thumbnailPhoto", "jpegPhoto" ],
    "Disabled": false
  },

  /* AD grubu -> uygulama rolu eslemesi. SID degerlerini kendi gruplarinizla
     degistirin:  (Get-ADGroup 'BookRunner-Authors').SID.Value
     Roller: Viewer, Contributor, RunbookAuthor, Administrator */
  "Authorization": {
    "RoleMappings": [
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1001",
        "GroupName": "BookRunner-Administrators",
        "Role": "Administrator"
      },
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1002",
        "GroupName": "BookRunner-Authors",
        "Role": "RunbookAuthor"
      },
      {
        "GroupSid": "S-1-5-21-0000000000-0000000000-0000000000-1003",
        "GroupName": "BookRunner-Contributors",
        "Role": "Contributor"
      }
    ]
  },

  "Email": {
    "Enabled": true,
    "Host": "smtp.contoso.com",
    "Port": 25,
    "UseStartTls": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "bookrunner@contoso.com",
    "FromDisplayName": "BookRunner",
    "WebBaseUrl": "http://localhost:5080",
    "MaxAttempts": 5,
    "PollingSeconds": 30,
    "BatchSize": 20,
    "RedirectAllTo": ""
  },

  /* Baglanti dizesi yukaridaki ConnectionStrings:ServiceManager degerinden gelir.
     Sorgular ortaminizdaki SCSM semasina gore buradan degistirilebilir. */
  "ServiceManager": {
    "Enabled": false,
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },

  "Scripting": {
    "Enabled": true,
    "DefaultTimeoutSeconds": 60,
    "MaxOutputLines": 500
  },

  "Integration": {
    "Enabled": false,
    "BaseUrl": "",
    "EventPath": "/api/events",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "EventTypes": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "BookRunner": "Information"
    }
  },

  "AllowedHosts": "*"
}
