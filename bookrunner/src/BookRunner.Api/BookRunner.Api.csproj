<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BookRunner.Api</RootNamespace>
    <UserSecretsId>bookrunner-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sunucuya ozel gercek ayarlar (appsettings.Local.json.example'dan kopyalanir,
         .gitignore'dadir). Var olmasi durumunda cikti klasorune kopyalanir; yoksa
         bu item hic olusmaz, derleme hata vermez. -->
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookRunner.Application\BookRunner.Application.csproj" />
    <ProjectReference Include="..\BookRunner.Domain\BookRunner.Domain.csproj" />
    <ProjectReference Include="..\BookRunner.Infrastructure\BookRunner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
