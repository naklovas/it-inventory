@model AuditViewModel
@{
    ViewData["Title"] = "Denetim kayitlari";
    var f = Model.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="br-page-title h3 mb-1">Denetim kayitlari</h1>
        <p class="br-muted mb-0">@Model.Results.TotalCount kayit. Kim, ne zaman, neyi degistirdi.</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Integrations">
        <i class="bi bi-plug me-1"></i>Entegrasyonlar
    </a>
</div>

<form class="br-card p-3 mb-3" method="get">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small br-muted">Kullanici</label>
            <input class="form-control" name="userName" value="@f.UserName" placeholder="DOMAIN\kullanici" />
        </div>
        <div class="col-md-2">
            <label class="form-label small br-muted">Islem</label>
            <select class="form-select" name="action">
                <option value="">Tumu</option>
                @foreach (AuditAction action in Enum.GetValues<AuditAction>())
                {
                    <option value="@action" selected="@(f.Action == action)">@DisplayText.Action(action)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small br-muted">Varlik</label>
            <input class="form-control" name="entityType" value="@f.EntityType" placeholder="Runbook" />
        </div>
        <div class="col-md-2">
            <label class="form-label small br-muted">Baslangic</label>
            <input class="form-control" type="date" name="from" value="@(f.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label small br-muted">Bitis</label>
            <input class="form-control" type="date" name="to" value="@(f.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
        </div>
    </div>
</form>

<div class="br-card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th style="width:150px;">Zaman</th>
                <th style="width:180px;">Kullanici</th>
                <th style="width:110px;">Islem</th>
                <th style="width:130px;">Varlik</th>
                <th>Ozet</th>
                <th style="width:110px;">IP</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center br-muted py-4">Kayit bulunamadi.</td></tr>
            }
            else
            {
                foreach (var log in Model.Results.Items)
                {
                    <tr>
                        <td class="small">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="small">
                            @(log.UserDisplayName ?? log.UserName)
                            <small class="d-block br-muted">@log.UserName</small>
                        </td>
                        <td><span class="badge text-bg-light border">@log.ActionText</span></td>
                        <td class="small">@log.EntityType</td>
                        <td class="small">
                            @log.Summary
                            @if (!string.IsNullOrWhiteSpace(log.Changes))
                            {
                                <details class="mt-1">
                                    <summary class="br-muted" style="cursor:pointer;">Degisiklikler</summary>
                                    <pre class="small mb-0" style="white-space:pre-wrap;">@log.Changes</pre>
                                </details>
                            }
                        </td>
                        <td class="small br-muted">@log.IpAddress</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="@(new PagerModel(Model.Results.Page, Model.Results.TotalPages, new Dictionary<string, string>
{
    ["userName"] = f.UserName ?? string.Empty,
    ["entityType"] = f.EntityType ?? string.Empty,
    ["action"] = f.Action?.ToString() ?? string.Empty
}))" />
