@model EmailOutboxViewModel
@using BookRunner.Domain.Enums
@{
    ViewData["Title"] = "E-posta kayitlari";
    var f = Model.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="br-page-title h3 mb-1">E-posta kayitlari</h1>
        <p class="br-muted mb-0">
            @Model.Results.TotalCount kayit. Ayarlarda "Email:Enabled" kapaliyken de her bildirim
            burada gorunur ama gonderilmez - gercek posta atmadan tetiklemeyi test etmek icin kullanin.
        </p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Audit">
        <i class="bi bi-shield-check me-1"></i>Denetim
    </a>
</div>

<form class="br-card p-3 mb-3" method="get">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small br-muted">Alici</label>
            <input class="form-control" name="to" value="@f.To" placeholder="orn. ali@fintek.local" />
        </div>
        <div class="col-md-2">
            <label class="form-label small br-muted">Durum</label>
            <select class="form-select" name="status">
                <option value="">Tumu</option>
                @foreach (EmailStatus status in Enum.GetValues<EmailStatus>())
                {
                    <option value="@status" selected="@(f.Status == status)">@DisplayText.EmailStatus(status)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small br-muted">Kaynak</label>
            <input class="form-control" name="reason" value="@f.Reason" placeholder="orn. TaskAssigned" />
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
        </div>
    </div>
</form>

<div class="br-card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th style="width:150px;">Olusturuldu</th>
                <th style="width:110px;">Durum</th>
                <th style="width:130px;">Kaynak</th>
                <th>Alici / Konu</th>
                <th style="width:90px;">Deneme</th>
                <th style="width:150px;">Gonderildi</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center br-muted py-4">Kayit bulunamadi.</td></tr>
            }
            else
            {
                foreach (var mail in Model.Results.Items)
                {
                    var badgeClass = mail.Status switch
                    {
                        EmailStatus.Sent => "text-bg-success-subtle border border-success-subtle text-success-emphasis",
                        EmailStatus.Failed => "text-bg-danger-subtle border border-danger-subtle text-danger-emphasis",
                        EmailStatus.Cancelled => "text-bg-secondary-subtle border",
                        _ => "text-bg-warning-subtle border border-warning-subtle text-warning-emphasis"
                    };

                    <tr>
                        <td class="small">@mail.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td><span class="badge @badgeClass">@mail.StatusText</span></td>
                        <td class="small">@(mail.Reason ?? "-")</td>
                        <td class="small">
                            <div>@mail.To</div>
                            <strong class="text-body">@mail.Subject</strong>
                            <details class="mt-1">
                                <summary class="br-muted" style="cursor:pointer;">Icerigi goster</summary>
                                <iframe class="border rounded mt-1" style="width:100%;height:220px;" sandbox=""
                                        srcdoc="@mail.HtmlBody"></iframe>
                            </details>
                            @if (!string.IsNullOrWhiteSpace(mail.LastError))
                            {
                                <div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle me-1"></i>@mail.LastError</div>
                            }
                        </td>
                        <td class="small">@mail.AttemptCount</td>
                        <td class="small">@(mail.SentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="@(new PagerModel(Model.Results.Page, Model.Results.TotalPages, new Dictionary<string, string>
{
    ["to"] = f.To ?? string.Empty,
    ["status"] = f.Status?.ToString() ?? string.Empty,
    ["reason"] = f.Reason ?? string.Empty
}))" />
