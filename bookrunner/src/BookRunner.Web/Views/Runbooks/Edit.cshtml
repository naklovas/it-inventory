@model RunbookFormViewModel
@{
    ViewData["Title"] = "Runbook duzenle";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="br-page-title h3 mb-0">@Model.Title</h1>
        <code class="br-muted">@Model.Code</code>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Id">
        <i class="bi bi-arrow-left me-1"></i>Detaya don
    </a>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="br-card p-3 p-lg-4">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Vazgec</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/scsm-lookup.js" asp-append-version="true"></script>
}
