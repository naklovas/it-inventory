@model RunbookFormViewModel
@{
    var isEdit = Model.Id.HasValue;
}

<div class="row g-3">
    <div class="col-md-8">
        <label class="form-label small br-muted">Baslik *</label>
        <input class="form-control" asp-for="Title" required minlength="3" maxlength="250"
               placeholder="Yapilacak isin kisa adi" />
        <span class="text-danger small" asp-validation-for="Title"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label small br-muted">Tur</label>
        <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" asp-for="IsTemplate" disabled="@isEdit" />
            <label class="form-check-label" asp-for="IsTemplate">Sablon olarak olustur</label>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label small br-muted">Aciklama</label>
        <textarea class="form-control" rows="5" asp-for="Description"
                  placeholder="Bu calisma neden yapiliyor, kapsami ne, hangi sistemleri etkiliyor?"></textarea>
    </div>

    @if (isEdit)
    {
        <div class="col-md-3">
            <label class="form-label small br-muted">Durum</label>
            <select class="form-select" asp-for="Status"
                    asp-items="@Html.GetEnumSelectList<RunbookStatus>()"></select>
        </div>
    }

    <div class="col-md-3">
        <label class="form-label small br-muted">Kategori (sablonlar icin)</label>
        <input class="form-control" asp-for="TemplateCategory" placeholder="orn. Veritabani Gecisi" />
    </div>

    <div class="col-md-3">
        <label class="form-label small br-muted">Seyir (ust baslik)</label>
        <input class="form-control" asp-for="SeyirName" list="seyirNameOptions"
               autocomplete="off" placeholder="orn. Veri Merkezi Migrasyonu" />
        <datalist id="seyirNameOptions">
            @foreach (var name in Model.SeyirNames)
            {
                <option value="@name"></option>
            }
        </datalist>
        <small class="br-muted">Birden fazla runbook'u ayni seyir altinda gruplar; listede aramak icin de kullanilir.</small>
    </div>

    <div class="col-md-3">
        <label class="form-label small br-muted" id="plannedStartLabel">Planlanan baslangic</label>
        <input class="form-control" type="datetime-local" asp-for="PlannedStart" />
        <span class="text-danger small" asp-validation-for="PlannedStart"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label small br-muted" id="plannedEndLabel">Planlanan bitis</label>
        <input class="form-control" type="datetime-local" asp-for="PlannedEnd" />
        <span class="text-danger small" asp-validation-for="PlannedEnd"></span>
    </div>

    <div class="col-md-4 position-relative">
        <label class="form-label small br-muted">Service Manager kaydi</label>
        <input class="form-control" asp-for="ServiceManagerWorkItemId" id="scsmInput"
               autocomplete="off" placeholder="orn. CR12345" />
        <div class="br-suggest" id="scsmSuggest"></div>
        <small class="br-muted">Kayit numarasi yazdikca Service Manager veritabanindan oneri gelir.</small>
    </div>

    <div class="col-md-8">
        <label class="form-label small br-muted">Etiketler</label>
        <input class="form-control" asp-for="TagsText" placeholder="virgulle ayirin: veritabani, gece-bakim" />
    </div>
</div>

<input type="hidden" asp-for="RowVersion" />

<script>
    (function () {
        var templateToggle = document.getElementById("IsTemplate");
        var start = document.getElementById("PlannedStart");
        var end = document.getElementById("PlannedEnd");
        var startLabel = document.getElementById("plannedStartLabel");
        var endLabel = document.getElementById("plannedEndLabel");

        // Sablon olmayan runbook'larda planlanan tarih zorunludur (gorev tarihi
        // kisitlamasi bu araligi kullanir); sablonlar somut bir zamana bagli
        // olmadigindan muaftir.
        function apply() {
            var required = !(templateToggle && templateToggle.checked);
            if (start) { start.required = required; }
            if (end) { end.required = required; }
            if (startLabel) { startLabel.textContent = "Planlanan baslangic" + (required ? " *" : ""); }
            if (endLabel) { endLabel.textContent = "Planlanan bitis" + (required ? " *" : ""); }
        }

        if (templateToggle) {
            templateToggle.addEventListener("change", apply);
        }
        apply();
    })();
</script>
