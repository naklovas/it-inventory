@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}
<div class="br-card p-5 text-center">
    <div class="display-6 mb-2"><i class="bi bi-emoji-frown text-warning"></i></div>
    <h1 class="br-page-title h4">Bir seyler ters gitti</h1>
    <p class="br-muted">@Model.Message</p>
    @if (Model.ShowRequestId)
    {
        <p class="small br-muted">Istek kimligi: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-1"></i>Panele don
    </a>
</div>
