@model PagerModel
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            @for (var pageNumber = Math.Max(1, Model.CurrentPage - 3); pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 3); pageNumber++)
            {
                var routeValues = new Dictionary<string, string>(Model.RouteValues) { ["page"] = pageNumber.ToString() };
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                    @* Filtre alanlarindan biri "action" adini tasirsa (orn. Denetim Kayitlari'ndaki
                       Islem filtresi), asp-controller/asp-action burada sabitlenmezse asp-all-route-data
                       bu degeri MVC'nin varsayilan rota sablonundaki action parametresiyle karistirip
                       sayfa linkini yanlis/olmayan bir controller action'a yonlendirir. *@
                    <a class="page-link"
                       asp-controller="@ViewContext.RouteData.Values["controller"]"
                       asp-action="@ViewContext.RouteData.Values["action"]"
                       asp-all-route-data="@routeValues">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
