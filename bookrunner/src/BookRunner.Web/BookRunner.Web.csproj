<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BookRunner.Web</RootNamespace>
    <UserSecretsId>bookrunner-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frontend, API'nin sozlesmelerini (DTO) yeniden kullanir; is mantigina
         dogrudan erisim yoktur, tum veri REST uzerinden gelir. -->
    <ProjectReference Include="..\BookRunner.Application\BookRunner.Application.csproj" />
    <ProjectReference Include="..\BookRunner.Domain\BookRunner.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sunucuya ozel gercek ayarlar (appsettings.Local.json.example'dan kopyalanir,
         .gitignore'dadir). Var olmasi durumunda cikti klasorune kopyalanir; yoksa
         bu item hic olusmaz, derleme hata vermez. -->
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

</Project>
